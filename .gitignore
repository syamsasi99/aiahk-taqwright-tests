node_modules/
.env
.env.local

# Recorded-run scratch: steps.json, adaptation briefs and verify targets are
# regenerated by lime-cli on every run, and can carry run data.
.lime/

# Test output
reports/
results/
test-results/
playwright-report/
*.log

# Failure screens, written by tests/hooks/capture-failure-screen.ts and posted by
# `lime-cli report --screens`. Never committed and never uploaded as an artifact: they hold
# the app's full UI tree, and LIME keeps only a signature, the labels and the elements a
# locator could name -- storing the raw source here would undo the one rule that design has.
lime-screens/

# The app binary. 147 MB, over GitHub's 100 MB file limit; the grid takes an lt:// id instead.
App/
